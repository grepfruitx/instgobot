# Telegram Bot API
TELEGRAM_BOT=
LOCAL_BOT_API_URL=https://api.telegram.org
ADMIN_USERNAME=@someone

# MTProto user account (stories/private posts) — my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USERBOT_SESSION_PATH=/root/instgobot/userbot.session

# Storage — the bot runs directly on the VPS host (systemd)
DB_PATH=/root/instgobot/bot_data.sqlite

# External tools — both already installed on the VPS host
YT_DLP_PATH=yt-dlp
